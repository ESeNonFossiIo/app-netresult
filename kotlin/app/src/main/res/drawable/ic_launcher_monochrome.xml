<?xml version="1.0" encoding="utf-8"?>
<!-- Single-colour tennis ball for themed (monochrome) launcher icons; same geometry as design/icon_fg.svg. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="512"
    android:viewportHeight="512">
    <group
        android:pivotX="256"
        android:pivotY="256"
        android:scaleX="0.88"
        android:scaleY="0.88">
        <!-- ball outline -->
        <path
            android:pathData="M86,256a170,170 0 1,0 340,0a170,170 0 1,0 -340,0"
            android:strokeColor="#000000"
            android:strokeWidth="18" />
        <!-- the two seams, kept inside the ball -->
        <group>
            <clip-path android:pathData="M86,256a170,170 0 1,0 340,0a170,170 0 1,0 -340,0" />
            <path
                android:pathData="M96,120C210,170 210,342 96,392"
                android:strokeColor="#000000"
                android:strokeWidth="26"
                android:strokeLineCap="round" />
            <path
                android:pathData="M416,120C302,170 302,342 416,392"
                android:strokeColor="#000000"
                android:strokeWidth="26"
                android:strokeLineCap="round" />
        </group>
    </group>
</vector>
